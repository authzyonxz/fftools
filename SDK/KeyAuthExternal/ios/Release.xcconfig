// Include in the Release configuration of your iOS app; iOS 15+; ARC.
IPHONEOS_DEPLOYMENT_TARGET = 15.0
CLANG_ENABLE_OBJC_ARC = YES
GCC_OPTIMIZATION_LEVEL = s
LLVM_LTO = YES_THIN
GCC_SYMBOLS_PRIVATE_EXTERN = YES
GCC_INLINES_ARE_PRIVATE_EXTERN = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = non-global
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_HARDENED_RUNTIME = NO
// Hardened Runtime is a macOS facility; do not advertise it as iOS protection.
// Archive dSYM privately, never inside the app. Preserve explicitly exported launcher symbols.
